---
import Base from '../layouts/Base.astro';
import body from '../fragments/contact.html?raw';
import pages from '../data/pages.json';
const p = pages.find((x) => x.slug === 'contact')!;
---
<Base title={p.title} description={p.description} path="/contact" cursor="menu" navTheme="light" back={{ href: "/", label: "← Home" }} ctaPhone dockActive="inquire">
  <style is:global>.cr[data-astro-cid-wcoxe63l]{padding:clamp(46px,8vh,96px) 0 clamp(10px,2vh,24px);width:100%}.cr-rule[data-astro-cid-wcoxe63l]{max-width:1360px;margin:0 auto clamp(26px,4vh,44px);height:1px;background:#241a1024}.cr-kick[data-astro-cid-wcoxe63l],.cr-head[data-astro-cid-wcoxe63l]{max-width:1360px;margin-inline:auto;color:#9a8f7c}.cr-kick[data-astro-cid-wcoxe63l]{font-size:var(--lab);letter-spacing:.18em;margin-bottom:clamp(26px,4vh,46px)}.cr-head[data-astro-cid-wcoxe63l]{font-size:var(--lab-quiet);letter-spacing:.18em;font-weight:400;margin-bottom:clamp(10px,1.6vh,16px)}.cr-band[data-astro-cid-wcoxe63l]+.cr-band[data-astro-cid-wcoxe63l]{margin-top:clamp(30px,5vh,58px)}.cr-marquee[data-astro-cid-wcoxe63l]{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent)}.cr-track[data-astro-cid-wcoxe63l]{display:flex;width:max-content;animation:cr-run 46s linear infinite}.cr-track--r[data-astro-cid-wcoxe63l]{animation-direction:reverse}@keyframes cr-run{to{transform:translate(-50%)}}.cr-marquee[data-astro-cid-wcoxe63l]:hover .cr-track[data-astro-cid-wcoxe63l],.cr-track[data-astro-cid-wcoxe63l]:focus-within{animation-play-state:paused}.cr-cell[data-astro-cid-wcoxe63l]{display:inline-flex;align-items:center;flex:none}.cr-name[data-astro-cid-wcoxe63l]{position:relative;font-family:goldenbook,Italiana,Cormorant,serif;font-weight:300;font-size:clamp(19px,2.3vw,34px);line-height:1.25;letter-spacing:.012em;color:#241a10;white-space:nowrap}.cr-name[data-astro-cid-wcoxe63l]:after{content:attr(data-txt);content:attr(data-txt) / "";position:absolute;left:0;top:0;white-space:nowrap;color:var(--red-hover);clip-path:inset(0 100% 0 0);transition:clip-path .55s cubic-bezier(.65,0,.35,1)}.cr-cell[data-astro-cid-wcoxe63l]:hover .cr-name[data-astro-cid-wcoxe63l]:after{clip-path:inset(0 0 0 0)}.cr-dot[data-astro-cid-wcoxe63l]{flex:none;width:4px;height:4px;margin:0 clamp(20px,2.6vw,44px);background:var(--red);opacity:.5;transform:rotate(45deg)}@media(prefers-reduced-motion:reduce){.cr-marquee[data-astro-cid-wcoxe63l]{-webkit-mask-image:none;mask-image:none}.cr-track[data-astro-cid-wcoxe63l]{animation:none;flex-wrap:wrap;width:auto;max-width:1360px;margin-inline:auto;row-gap:10px}.cr-cell[data-astro-cid-wcoxe63l][aria-hidden=true]{display:none}}.cr-narrow[data-astro-cid-wcoxe63l]{text-align:left}.cr-narrow[data-astro-cid-wcoxe63l] .cr-rule[data-astro-cid-wcoxe63l],.cr-narrow[data-astro-cid-wcoxe63l] .cr-kick[data-astro-cid-wcoxe63l],.cr-narrow[data-astro-cid-wcoxe63l] .cr-head[data-astro-cid-wcoxe63l]{max-width:800px}
.close-row{color:#241a10;transition:color .35s ease,transform .5s cubic-bezier(.22,1,.36,1)}.next-tag{display:block;font-size:var(--lab-quiet);letter-spacing:.16em;color:var(--red);margin-bottom:10px}.close-row--next{align-items:flex-end!important}.close-row:hover{transform:translate(1.1vw)}@media(prefers-reduced-motion:reduce){.close-row:hover{color:var(--red)}}.close-meta{opacity:0;transform:translate(-8px);transition:opacity .4s ease .06s,transform .4s ease .06s}.close-row:hover .close-meta{opacity:1;transform:none}@media(hover:none){.close-meta{opacity:1}}@media(max-width:640px){.close-meta{display:none}}
@media(prefers-reduced-motion:no-preference){html.js [data-reveal]{opacity:0;transform:translateY(22px)}html.revealed [data-reveal]{opacity:1;transform:none;transition:opacity .85s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1);transition-delay:var(--reveal-d, 0s)}}@media(max-width:640px){.contact-main[data-astro-cid-uw5kdbxl]{padding-left:24px!important;padding-right:24px!important}.hb-embed[data-astro-cid-uw5kdbxl]{max-width:none!important;margin-inline:0!important}}.hb-embed[data-astro-cid-uw5kdbxl] iframe[data-astro-cid-uw5kdbxl]{width:100%!important;max-width:none!important}.portal-line[data-astro-cid-uw5kdbxl] a[data-astro-cid-uw5kdbxl]:hover{color:#1c1813;text-decoration-color:#1c181380}.portal-line[data-astro-cid-uw5kdbxl] a[data-astro-cid-uw5kdbxl]{display:inline-block;padding:12px 8px}
</style>
  <Fragment set:html={body} />
  <script>
    import '../scripts/pages/contact';
  </script>
</Base>
