---
import Base from '../layouts/Base.astro';
import body from '../fragments/maryland-virginia-wedding-photographer.html?raw';
import '../styles/pages/svc.css';
import pages from '../data/pages.json';
const p = pages.find((x) => x.slug === 'maryland-virginia-wedding-photographer')!;
---
<Base title={p.title} description={p.description} path="/maryland-virginia-wedding-photographer" cursor="menu" navTheme="dark" back={{ href: "/", label: "← Home" }} ogImage="/img/story/r03-w1200.webp">
  
  <Fragment set:html={body} />
  <script>
    import '../scripts/pages/svc';
  </script>
</Base>
